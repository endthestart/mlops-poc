[Unit]
Description=Weekend ML Training Pipeline
After=ml-ssh-tunnel.service
Requires=ml-ssh-tunnel.service

[Service]
Type=oneshot
User=andermic
TimeoutStartSec=50400
WorkingDirectory=/home/andermic/Development/senex-project/senextrader
EnvironmentFile=/home/andermic/Development/senex-project/senextrader/.env.ml
ExecStartPre=-/usr/bin/podman stop ollama
ExecStartPost=-/usr/bin/podman start ollama
ExecStart=/home/andermic/Development/senex-project/senextrader/.venv/bin/python -m ml.scripts.weekend_training --parallel

[Install]
WantedBy=multi-user.target
